# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Configured for production at https://tvcomigo.vercel.app
APP_URL="https://tvcomigo.vercel.app"
VITE_APP_URL="https://tvcomigo.vercel.app"
VITE_PUBLIC_URL="https://tvcomigo.vercel.app"

# Optional: External WebSocket server URL if deploying fully on Vercel Edge/Serverless
# VITE_WS_URL="wss://your-sync-server.example.com"

